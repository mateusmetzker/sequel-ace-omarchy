"function_argument_snippets": {
"CONCAT": "${1:str1}, ${2:str2}",
"CHAR": "${1:N}, ${2:USING ${3:charset_name}}",
"MASTER_POS_WAIT": "${1:log_name}, ${2:log_pos}${3:, ${4:timeout}}",
"WEEK": "${1:date}${2:, ${3:mode}}",
"UpdateXML": "${1:xml_target}, ${2:xpath_expr}, ${3:new_xml}",
"MID": "${1:str}, ${2:pos}, ${3:len}",
"ROUND": "${1:X}${2:, ${3:D}}",
"NULLIF": "${1:expr1}, ${2:expr2}",
"TIMEDIFF": "${1:expr1}, ${2:expr2}",
"REPLACE": "${1:str}, ${2:from_str}, ${3:to_str}",
"ADDTIME": "${1:expr1}, ${2:expr2}",
"TIMESTAMPDIFF": "${1:unit}, ${2:datetime_expr1}, ${3:datetime_expr2}",
"FROM_UNIXTIME": "${1:unix_timestamp}${2:, ${3:format}}",
"IFNULL": "${1:expr1}, ${2:expr2}",
"LEAST": "${1:value1}, ${2:value2}",
"MATCH": "${1:col_list}) AGAINST (${2:expr}${3: ${4:¦IN BOOLEAN MODE¦IN NATURAL LANGUAGE MODE¦IN NATURAL LANGUAGE MODE WITH QUERY EXPANSION¦WITH QUERY EXPANSION¦}}",
"DES_DECRYPT": "${1:crypt_str}${2:, ${3:key_str}}",
"DECODE": "${1:crypt_str}, ${2:pass_str}",
